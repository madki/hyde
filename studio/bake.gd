extends Node
## Bakes the street background to light-pass textures. Desktop only; run with Forward+:
##
##   tools/bake_bg.sh [--variant=jekyll|hyde] [--passes=/abs/dir] [--rebuild]
##
## `--variant=alley` bakes the back alley instead, studio/alley.tscn, generated by
## studio/alley_builder.gd (tools/bake_alley.sh does that and its figure in one go), and
## `--variant=lab` the laboratory, studio/lab.tscn, generated by studio/lab_builder.gd
## (tools/bake_lab.sh). `--variant=title_jekyll` and `title_hyde` bake the title screen's two
## streets: the game's, with the shadow of the man where he stands on the title screen
## (studio/title_street.gd; tools/bake_title.sh does both, and the men).
##
## The streets are ordinary scenes, studio/street_jekyll.tscn and studio/street_hyde.tscn:
## open them in the 3D editor, move the camera, lamps and props, save, then re-bake.
## `--rebuild` throws those scenes away and regenerates them from studio/street_builder.gd.
##
## Each pass renders one group of lights in white, so the result is a greyscale "how much of
## this light reaches this pixel" image. Lights and glowing meshes are assigned to a pass with
## node groups: pass_key, pass_wall, pass_windows, pass_ambient. Two textures per variant:
##
##   <variant>_a.png   R = key lamp   G = wall lanterns + far lamps   B = ambient / moon
##   <variant>_b.png   R = lit windows   G = mist (distance + ground fog)   B = sky mask
##
## A picture with somebody baked into it in his own colours (Jekyll in the laboratory) gets a
## third: meshes in the group "own_colour" are drawn in their vertex colours (see `--colours`
## of studio/import_figure.gd) and everything else in white.
##
##   <variant>_c.png   RGB = the colour of whatever has one of its own, white elsewhere
##
## The street is baked with nobody in it. The two men are a layer of their own, baked from the
## same scenes by studio/figure_bake.gd (tools/bake_figures.sh): re-run that too after moving
## the camera, a lamp or a figure.
##
## shaders/background.gdshader colours and animates them at runtime.
## `--passes` also writes every pass as its own PNG, for checking the bake by eye.

const SIZE := Vector2i(1920, 1080)
const OUT_DIR := "res://art/bg/"
const LIGHT_PASSES := ["key", "wall", "windows", "ambient"]
const SETTLE_FRAMES := 24 # volumetric fog is temporally accumulated
## Scenes that do not follow the streets' naming.
const SCENES := {"alley": "res://studio/alley.tscn", "lab": "res://studio/lab.tscn"}

var _viewport: SubViewport
var _env: Environment


func _ready() -> void:
	_write_noise()
	var only := Shot.arg("variant")
	for v: String in (["jekyll", "hyde"] if only == "" else [only]):
		await _bake(v)
	get_tree().quit()


func _bake(variant: String) -> void:
	_viewport = SubViewport.new()
	_viewport.size = SIZE
	_viewport.own_world_3d = true
	_viewport.msaa_3d = Viewport.MSAA_4X
	_viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	add_child(_viewport)
	var man := variant.trim_prefix("title_") # whose street it is, for a street
	var path: String = SCENES.get(variant, "res://studio/street_%s.tscn" % man)
	if Shot.has_arg("rebuild") or not ResourceLoader.exists(path):
		var built: Node3D
		match variant:
			"alley":
				built = AlleyBuilder.build()
			"lab":
				built = LabBuilder.build()
			_:
				built = StreetBuilder.build(man)
		var packed := PackedScene.new()
		packed.pack(built)
		ResourceSaver.save(packed, path)
		built.free()
		print("generated ", path)
	var street: Node3D = (ResourceLoader.load(path, "", ResourceLoader.CACHE_MODE_IGNORE)
			as PackedScene).instantiate()
	_viewport.add_child(street)
	if variant.begins_with("title_"):
		TitleStreet.stage(street, man)
	_env = Environment.new()
	var world_env := WorldEnvironment.new()
	world_env.environment = _env
	street.add_child(world_env)

	for n: GeometryInstance3D in get_tree().get_nodes_in_group("figure"):
		# A man who stays where he is still throws his shadow on the picture.
		if n.is_in_group("casts_shadow"):
			n.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY
		else:
			n.visible = false
	var lum := {}
	for p: String in ["key", "wall", "windows", "ambient", "mist", "sky"]:
		var img := await _render(p)
		if Shot.has_arg("passes"):
			img.save_png(Shot.arg("passes").path_join("%s_%s.png" % [variant, p]))
		lum[p] = _luminance(img)
	_pack(lum.key, lum.wall, lum.ambient).save_png(OUT_DIR + variant + "_a.png")
	_pack(lum.windows, lum.mist, lum.sky).save_png(OUT_DIR + variant + "_b.png")
	if not get_tree().get_nodes_in_group("own_colour").is_empty():
		_show_colours(street)
		var colours := await _render("colour")
		if Shot.has_arg("passes"):
			colours.save_png(Shot.arg("passes").path_join(variant + "_colour.png"))
		colours.save_png(OUT_DIR + variant + "_c.png")
	print("baked ", variant)
	_viewport.queue_free()
	await get_tree().process_frame


## Dresses the scene for the colour pass: plain white, but for what has colours of its own.
## Nothing is put back, so this pass has to be the last.
func _show_colours(street: Node3D) -> void:
	var white := StandardMaterial3D.new()
	white.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	var own := ShaderMaterial.new()
	own.shader = Shader.new()
	# Kept a little under white, so that the game's shader can tell a white shirt from the room.
	own.shader.code = "shader_type spatial;\nrender_mode unshaded, cull_disabled;\n" \
			+ "void fragment() { ALBEDO = COLOR.rgb * 0.7; }\n"
	for n: GeometryInstance3D in street.find_children("*", "GeometryInstance3D", true, false):
		n.material_override = own if n.is_in_group("own_colour") else white


func _render(p: String) -> Image:
	_setup_pass(p)
	for i in SETTLE_FRAMES:
		await get_tree().process_frame
	await RenderingServer.frame_post_draw
	var img := _viewport.get_texture().get_image()
	img.convert(Image.FORMAT_RGB8)
	return img


func _setup_pass(p: String) -> void:
	for group: String in LIGHT_PASSES:
		for n: Node3D in get_tree().get_nodes_in_group("pass_" + group):
			n.visible = group == p
	var e := _env
	e.background_mode = Environment.BG_COLOR
	e.background_color = Color.WHITE if p in ["mist", "sky", "colour"] else Color.BLACK
	e.tonemap_mode = Environment.TONE_MAPPER_LINEAR
	e.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	e.ambient_light_color = Color.WHITE
	e.ambient_light_energy = 0.55 if p == "ambient" else 0.0
	e.reflected_light_source = Environment.REFLECTION_SOURCE_DISABLED
	e.ssao_enabled = p == "ambient"
	e.ssao_radius = 2.0
	e.ssao_intensity = 3.0
	# Lamp halos: only the lamp passes scatter in the air.
	e.volumetric_fog_enabled = p in ["key", "wall"]
	e.volumetric_fog_density = 0.018
	e.volumetric_fog_albedo = Color.WHITE
	e.volumetric_fog_length = 70.0
	e.volumetric_fog_ambient_inject = 0.0
	e.volumetric_fog_gi_inject = 0.0
	e.volumetric_fog_anisotropy = 0.5
	# Mist: a black scene under white distance + ground fog gives the fog amount directly.
	e.fog_enabled = p == "mist"
	e.fog_light_color = Color.WHITE
	e.fog_light_energy = 1.0
	e.fog_sun_scatter = 0.0
	e.fog_density = 0.028
	e.fog_height = 1.2
	e.fog_height_density = 0.2
	e.fog_aerial_perspective = 0.0
	e.fog_sky_affect = 0.0


## Tileable RGB noise (three independent layers) used by the shader for clouds, flicker,
## grain and the transition. Generated by code; only written if it is missing.
func _write_noise() -> void:
	var path := OUT_DIR + "noise.png"
	if FileAccess.file_exists(path):
		return
	var size := 256
	var data := PackedByteArray()
	data.resize(size * size * 3)
	for c in 3:
		var fnl := FastNoiseLite.new()
		fnl.seed = 11 + c * 7
		fnl.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
		fnl.frequency = 0.012
		fnl.fractal_octaves = 4
		var img := fnl.get_seamless_image(size, size, false, false, 0.25)
		for i in size * size:
			data[i * 3 + c] = img.get_pixel(i % size, i / size).r8
	Image.create_from_data(size, size, false, Image.FORMAT_RGB8, data).save_png(path)


func _luminance(img: Image) -> PackedByteArray:
	var src := img.get_data()
	var out := PackedByteArray()
	var n := SIZE.x * SIZE.y
	out.resize(n)
	for i in n:
		var j := i * 3
		out[i] = (src[j] * 77 + src[j + 1] * 150 + src[j + 2] * 29) >> 8
	return out


func _pack(r: PackedByteArray, g: PackedByteArray, b: PackedByteArray) -> Image:
	var n := SIZE.x * SIZE.y
	var data := PackedByteArray()
	data.resize(n * 3)
	for i in n:
		var j := i * 3
		data[j] = r[i]
		data[j + 1] = g[i]
		data[j + 2] = b[i]
	return Image.create_from_data(SIZE.x, SIZE.y, false, Image.FORMAT_RGB8, data)
