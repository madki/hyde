# Godot 4+ specific ignores
.godot/
/android/

# Godot MCP plugin and server config - local only, set up with tools/install_mcp.sh
/addons/godot_mcp/
/.mcp.json

# Export output (builds are uploaded to itch.io, not committed)
/build/*
!/build/.gdignore
/export/
/dist/
*.pck
*.apk
*.aab
*.ipa
*.dmg
*.exe

# Secrets and signing material - never commit
.env
.env.*
!.env.example
/secrets/
*.keystore
*.jks
*.pem
*.p12
*.mobileprovision
export_credentials.cfg

# Claude Code - personal/local state (shared settings live in .claude/settings.json)
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
*.translation

# Figure distance fields, rebuilt on demand by studio/figure_sdf.gd
/studio/cache/

# Jekyll's figure meshes are made from a licensed model that may not be passed on: they stay
# out of the repository. Only pictures rendered from them are committed (see CREDITS.md).
/studio/figures/jekyll*.res
