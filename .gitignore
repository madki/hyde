# Godot 4+ specific ignores
.godot/
/android/

# Godot MCP editor plugin - local only, install with tools/install_mcp.sh
/addons/godot_mcp/

# Export output (builds are uploaded to itch.io, not committed)
/build/*
!/build/.gdignore
/export/
/dist/
*.pck
*.apk
*.aab
*.ipa
*.dmg
*.exe

# Secrets and signing material - never commit
.env
.env.*
!.env.example
/secrets/
*.keystore
*.jks
*.pem
*.p12
*.mobileprovision
export_credentials.cfg

# Claude Code - personal/local state (shared settings live in .claude/settings.json)
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
*.translation
